{% extends 'base.html.twig' %}

{% block title %} FocusGallery {% endblock %}

{% block body %}

    <main>

        <div class = "main-container" >

        <div>
        <br>
        <h1> Découvrez nos clichés </h1>
        </div>

        <div class = "category-container">


            <div style = "background-color: #D1D1D1; width: auto; height: 20px; padding: 15px; border-radius: 40px;">
           
            <a href="/category" style = "color:black;">Tout</a>
    
            </div>

            {{render(controller('App\\Controller\\Partials\\NavCategoriesController::getCategories'))}}

        </div>

        <br>
        <br>

        <div class = "photo-container">

        {% for photo in photos %}

                <a href="{{ path('app_photo_show', {'id': photo.id}) }}">
                <div class="photo-card">

                <img src="../uploads/photos/{{ (photo.imageName) }}" alt="{{photo.title}}" style = "width : 100%; height: 100%; border-radius: 10px;">

                <div style = "display: flex; flex-direction: row; gap : 50px; align-items:center; padding: 5px; height: 10%;">

                    <h3 style = "color: black;">{{photo.title}}</h3>
                    <div class="category" style = "background-color: {{photo.category.color}}; color: white; padding: 10px 20px;">{{photo.category.name}}</div>

                </div>
    
                </div>
                </a>

                
        {% else %}
            
                <span>Rien à afficher pour cette catégorie.</span>
       
        {% endfor %}

        </div>


        </div>

    </main>
    

{% endblock %}
